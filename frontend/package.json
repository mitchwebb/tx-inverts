{
    "name": "frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier \"**/*.{ts,js,tsx,jsx,svelte,css,scss,html,json,md}\" --write",
        "vitest": "vitest",
        "test:chrome": "npx playwright test --headed --browser=chromium",
        "test:firefox": "npx playwright test --headed --browser=firefox",
        "test:safari": "npx playwright test --headed --browser=webkit"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@sveltejs/vite-plugin-svelte": "^5.0.3",
        "@tsconfig/svelte": "^5.0.4",
        "@types/node": "^24.0.10",
        "vite": "^6.0.5",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "air-datepicker": "^3.6.0",
        "dotenv": "^16.4.7",
        "mapbox-gl": "^3.10.0",
        "playwright": "^1.58.2",
        "prettier": "^3.7.4",
        "prettier-plugin-svelte": "^3.4.1",
        "svelte": "^5.0.0-next.272"
    },
    "prettier": {
        "plugins": [
            "prettier-plugin-svelte"
        ],
        "trailingComma": "es5",
        "useTabs": false,
        "bracketSpacing": true,
        "endOfLine": "lf",
        "htmlWhitespaceSensitivity": "css",
        "jsxBracketSameLine": false,
        "jsxSingleQuote": false,
        "printWidth": 80,
        "semi": true,
        "singleQuote": true,
        "tabWidth": 4
    }
}
